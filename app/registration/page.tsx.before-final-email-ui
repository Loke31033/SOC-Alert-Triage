"use client";

import { FormEvent, useMemo, useState } from "react";

type Member = {
  name: string;
  username: string;
  email: string;
};

const EMPTY_MEMBERS: Member[] = Array.from({ length: 6 }, () => ({
  name: "",
  username: "",
  email: "",
}));

export default function RegistrationPage() {
  const [teamName, setTeamName] = useState("");
  const [error, setError] = useState("");
  const [teamId, setTeamId] = useState("");
  const [members, setMembers] = useState<Member[]>(EMPTY_MEMBERS);
  const [registrationEmail, setRegistrationEmail] = useState("");
  const [password, setPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [submitted, setSubmitted] = useState(false);

  const passwordValid = password.length >= 8;
  const passwordsMatch =
    password.length > 0 &&
    confirmPassword.length > 0 &&
    password === confirmPassword;

  const usernamesUnique = useMemo(() => {
    const usernames = members
      .map((member) => member.username.trim().toLowerCase())
      .filter(Boolean);

    return new Set(usernames).size === usernames.length;
  }, [members]);

  const studentEmailsValid = useMemo(() => {
    return members.every(
      (member) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(member.email.trim())
    );
  }, [members]);

  function updateMember(
    index: number,
    field: keyof Member,
    value: string
  ) {
    setMembers((current) =>
      current.map((member, memberIndex) =>
        memberIndex === index
          ? { ...member, [field]: value }
          : member
      )
    );
  }

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSubmitted(false);

    if (!teamName.trim() || !teamId.trim()) {
      return;
    }

    if (
      !registrationEmail.trim() ||
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(registrationEmail.trim())
    ) {
      setError("Please enter a valid email address.");
      return;
    }

    if (members.some((member) => !member.name.trim() || !member.username.trim())) {
      return;
    }

    if (!usernamesUnique || !passwordValid || !passwordsMatch) {
      return;
    }

    try {
      const response = await fetch("/api/registration", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          team_name: teamName.trim(),
          email: registrationEmail.trim(),
          team_id: teamId.trim().toUpperCase(),
          password,
          members: members.map((member) => ({
            name: member.name.trim(),
            username: member.username.trim().toLowerCase(),
            email: member.email.trim().toLowerCase(),
          })),
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(
          data?.error || "Unable to register the team."
        );
      }

      setSubmitted(true);
    } catch (error) {
      console.error("[REGISTRATION UI ERROR]", error);
      window.alert(
        error instanceof Error
          ? error.message
          : "Unable to register the team."
      );
    }
  }

  const formReady =
    teamName.trim().length > 0 &&
    teamId.trim().length > 0 &&
    members.every(
      (member) => member.name.trim() && member.username.trim()
    ) &&
    usernamesUnique &&
    studentEmailsValid &&
    passwordValid &&
    passwordsMatch;

  return (
    <main className="registration-page">
      <div className="registration-shell">
        <section className="registration-brand">
          <div className="brand-mark">SOC</div>

          <div>
            <p className="eyebrow">SOC CONTEST</p>
            <h1>Team Registration</h1>
            <p className="brand-description">
              Register your six-member security operations team.
              Each member will use an individual username with the
              shared team password.
            </p>
          </div>

          <div className="security-note">
            <span className="security-icon">◆</span>
            <div>
              <strong>Controlled registration</strong>
              <p>
                Exactly 6 students are required for every team.
              </p>
            </div>
          </div>
        </section>

        <section className="registration-card">
          <div className="card-header">
            <div>
              <p className="section-kicker">STEP 01</p>
              <h2>Create your team</h2>
              <p>
                Enter the team identity and six individual student
                accounts.
              </p>
            </div>

            <div className="member-count">
              <span>TEAM SIZE</span>
              <strong>6</strong>
            </div>
          </div>

          <form onSubmit={handleSubmit}>
            <section className="form-section">
              <div className="section-title">
                <span className="number">01</span>
                <div>
                  <h3>Team details</h3>
                  <p>Use the official team name and unique Team ID.</p>
                </div>
              </div>

              <div className="field-grid">
                <label className="field">
                  <span>Team Name</span>
                  <input
                    value={teamName}
                    onChange={(event) => setTeamName(event.target.value)}
                    placeholder="e.g. Blue SOC Warriors"
                    autoComplete="organization"
                    required
                  />
                </label>

                <label className="field">
                  <span>Team ID</span>
                  <input
                    value={teamId}
                    onChange={(event) =>
                      setTeamId(
                        event.target.value
                          .toUpperCase()
                          .replace(/[^A-Z0-9_-]/g, "")
                      )
                    }
                    placeholder="e.g. TEAM01"
                    pattern="[A-Z0-9_-]+"
                    required
                  />
                  <small>
                    Letters, numbers, underscore and hyphen only.
                  </small>
                </label>
              </div>
            </section>

            <section className="form-section">
              <div className="section-title">
                <span className="number">02</span>
                <div>
                  <h3>Team members</h3>
                  <p>
                    Each member receives an individual username.
                  </p>
                </div>
              </div>

              
              <div className="field" style={{ marginBottom: "20px" }}>
                <label htmlFor="registrationEmail">
                  Registration Email
                </label>

                <input
                  id="registrationEmail"
                  name="registrationEmail"
                  type="email"
                  value={registrationEmail}
                  onChange={(event) =>
                    setRegistrationEmail(event.target.value)
                  }
                  placeholder="Enter email address"
                  autoComplete="email"
                  required
                />

                <small>
                  Team registration details and login credentials will be
                  sent to this email address.
                </small>
              </div>

<div className="members-table">
                <div className="members-header">
                  <span>#</span>
                  <span>Student name</span>
                  <span>Username</span>
                  <span>Student email</span>
                </div>

                {members.map((member, index) => (
                  <div className="member-row" key={index}>
                    <div className="member-number">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <input
                      value={member.name}
                      onChange={(event) =>
                        updateMember(index, "name", event.target.value)
                      }
                      placeholder={`Student ${index + 1} name`}
                      autoComplete="name"
                      required
                    />

                    <input
                      value={member.username}
                      onChange={(event) =>
                        updateMember(
                          index,
                          "username",
                          event.target.value
                            .toLowerCase()
                            .replace(/\s+/g, "")
                        )
                      }
                      placeholder={`teamid_student${index + 1}`}
                      autoComplete="username"
                      required
                    />

                    <input
                      type="email"
                      value={member.email}
                      onChange={(event) =>
                        updateMember(index, "email", event.target.value)
                      }
                      placeholder={`student${index + 1}@example.com`}
                      autoComplete="email"
                      required
                    />
                  </div>
                ))}
              </div>

              {!usernamesUnique && (
                <p className="validation-error">
                  Each student username must be unique.
                </p>
              )}

              {!studentEmailsValid && (
                <p className="validation-error">
                  Please enter a valid email address for all six students.
                </p>
              )}
            </section>

            <section className="form-section">
              <div className="section-title">
                <span className="number">03</span>
                <div>
                  <h3>Shared team password</h3>
                  <p>
                    All six members will use this password with their
                    own username.
                  </p>
                </div>
              </div>

              <div className="password-grid">
                <label className="field">
                  <span>Team Password</span>
                  <div className="password-wrapper">
                    <input
                      type={showPassword ? "text" : "password"}
                      value={password}
                      onChange={(event) =>
                        setPassword(event.target.value)
                      }
                      placeholder="Minimum 8 characters"
                      autoComplete="new-password"
                      minLength={8}
                      required
                    />
                    <button
                      type="button"
                      className="password-toggle"
                      onClick={() => setShowPassword((value) => !value)}
                      aria-label={
                        showPassword
                          ? "Hide password"
                          : "Show password"
                      }
                    >
                      {showPassword ? "HIDE" : "SHOW"}
                    </button>
                  </div>
                  <small
                    className={passwordValid ? "valid-text" : ""}
                  >
                    {password.length === 0
                      ? "Minimum 8 characters."
                      : passwordValid
                        ? "Password length requirement satisfied."
                        : "Password must contain at least 8 characters."}
                  </small>
                </label>

                <label className="field">
                  <span>Confirm Team Password</span>
                  <div className="password-wrapper">
                    <input
                      type={showConfirmPassword ? "text" : "password"}
                      value={confirmPassword}
                      onChange={(event) =>
                        setConfirmPassword(event.target.value)
                      }
                      placeholder="Re-enter team password"
                      autoComplete="new-password"
                      minLength={8}
                      required
                    />
                    <button
                      type="button"
                      className="password-toggle"
                      onClick={() =>
                        setShowConfirmPassword((value) => !value)
                      }
                      aria-label={
                        showConfirmPassword
                          ? "Hide password"
                          : "Show password"
                      }
                    >
                      {showConfirmPassword ? "HIDE" : "SHOW"}
                    </button>
                  </div>
                  {confirmPassword.length > 0 && (
                    <small
                      className={
                        passwordsMatch
                          ? "valid-text"
                          : "validation-error"
                      }
                    >
                      {passwordsMatch
                        ? "Passwords match."
                        : "Passwords do not match."}
                    </small>
                  )}
                </label>
              </div>

              <div className="password-info">
                <span>i</span>
                <p>
                  The shared password is intended for the six members
                  of this team. Each student still has a separate
                  username for identification and team access control.
                </p>
              </div>
            </section>

            <div className="form-footer">
              <div className="form-status">
                <span className={formReady ? "status-dot ready" : "status-dot"} />
                <span>
                  {formReady
                    ? "Registration form is ready."
                    : "Complete all required fields."}
                </span>
              </div>

              <button
                className="register-button"
                type="submit"
                disabled={!formReady}
              >
                <span>CREATE TEAM</span>
                <span className="arrow">→</span>
              </button>
            </div>

            {submitted && (
              <div className="demo-success">
                <strong>Registration successful.</strong>
                <span>
                  Phase 8F-1 is UI-only. Database registration will be
